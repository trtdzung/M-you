# AI facade — LLM provider (server-side only). Copy to .env.local and fill in.
# .env.local is gitignored; never commit real keys.

# Provider selector: "anthropic" (default) | "openai" (OpenAI, e.g. gpt-4o-mini)
# | "vng" (VNG GreenNode, OpenAI-compatible) | "none" to force offline mode.
LLM_PROVIDER=anthropic

# Anthropic (default provider). Leave empty to run the assistant in offline
# fallback mode (the app still builds and runs without a key).
ANTHROPIC_API_KEY=

# OpenAI (OpenAI-compatible: gpt-4o-mini, gpt-4o, …). Used when LLM_PROVIDER=openai.
# Leave the key empty to fall back offline.
OPENAI_API_KEY=
# Optional base URL override (defaults to https://api.openai.com/v1).
OPENAI_BASE_URL=https://api.openai.com/v1

# Agent integration endpoints (must be absolute URLs)
# AGENT_API_BASE_URL handles chat classification and fallback logic
AGENT_API_BASE_URL=http://localhost:8080
# AGENT_INSIGHT_API_URL overrides the endpoint specifically for background proactive insights
# Default if unset: ${AGENT_API_BASE_URL}/insight
AGENT_INSIGHT_API_URL=http://localhost:8080/insight

# VNG GreenNode AI Platform (OpenAI-compatible: Qwen, GLM, …). Used when
# LLM_PROVIDER=vng. Leave the key empty to fall back offline.
AI_PLATFORM_API_KEY=
# Optional base URL override (defaults to the HCM MaaS endpoint).
LLM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1

# Optional model override (defaults per provider, e.g. claude-sonnet-5 for
# anthropic, gpt-4o-mini for openai, qwen/qwen3.6-flash for vng).
LLM_MODEL=

# Streaming Vietnamese STT. Server-only; never prefix the key with NEXT_PUBLIC_.
STT_API_BASE_URL=
STT_SERVICE_API_KEY=
# Set to the public PFM origin when deployed behind a reverse proxy.
# APP_ORIGIN=https://your-pfm.example.com
